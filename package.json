{
  "name": "fopost-zapier",
  "version": "0.0.0",
  "private": true,
  "description": "Official FoPost integration for Zapier. Schedule, publish and track social posts across 30+ networks from any Zap.",
  "license": "MIT",
  "author": "Porter Bridge, LLC",
  "homepage": "https://fopost.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fopost/fopost-zapier.git"
  },
  "bugs": {
    "url": "https://github.com/fopost/fopost-zapier/issues"
  },
  "keywords": [
    "fopost",
    "zapier",
    "zapier-platform-app",
    "social-media",
    "publishing",
    "scheduling",
    "automation"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "_zapier-build": "npm run build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit -p tsconfig.test.json && prettier --check .",
    "format": "prettier --write .",
    "validate": "zapier-platform validate",
    "push": "zapier-platform push",
    "register": "zapier-platform register"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "zapier-platform-cli": "^19.1.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10.7.0"
  }
}
